# --- База ---
DATABASE_URL=postgresql+asyncpg://litclub:litclub@localhost:5433/litclub

# --- Telegram ---
# Получить у @BotFather: /newbot, затем /newapp для Mini App.
# ВАЖНО: у бота должен быть выключен privacy mode
# (@BotFather → /mybots → Bot Settings → Group Privacy → Turn off),
# иначе он не увидит сообщения в переговорках и не сможет их вычистить.
TELEGRAM_BOT_TOKEN=
# Имя бота без @ — нужно для ссылок вида t.me/<bot>/app
TELEGRAM_BOT_USERNAME=
# HTTPS-адрес Mini App (localhost Telegram не принимает).
# В разработке — адрес туннеля, см. README.
MINIAPP_URL=

# --- Источники книг ---
# Google Books работает и без ключа, с ключом выше лимиты:
# https://console.cloud.google.com/apis/library/books.googleapis.com
GOOGLE_BOOKS_API_KEY=
GOOGLE_BOOKS_BASE_URL=https://www.googleapis.com/books/v1
# Open Library ключа не требует вовсе.
OPEN_LIBRARY_BASE_URL=https://openlibrary.org
BOOKS_LANGUAGE=ru
# Общий таймаут на внешний поиск, секунды. Источник, не уложившийся в него,
# молча выпадает из выдачи — поиск обязан работать и на одном источнике.
BOOKS_SEARCH_TIMEOUT=8.0

# --- Приложение ---
# Секрет для подписи сессионных JWT. Сгенерировать: openssl rand -hex 32
SECRET_KEY=change-me-openssl-rand-hex-32
DISPLAY_TIMEZONE=Europe/Moscow
# Telegram ID первого суперадмина: узнать, написав боту @userinfobot
BOOTSTRAP_SUPERADMIN_TG_ID=
